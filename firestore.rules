rules_version = '2';

// This Firebase project (tal-coordinator) is shared between four apps:
//   • Foundry Planner — alliance-trust model, no auth (see CLAUDE.md). Reads
//     and writes are open on the collections it owns.
//   • Alliance Wiki — same alliance-trust model (client-side admin password
//     check, no Firebase Auth). Reads and writes are open on its collections.
//   • SvS Preparation — same alliance-trust model. `svs_forms` holds one doc
//     per round (state_admin-or-above managed, scoped to their own state —
//     see svs-prep's admin pages and the svs_forms rule below);
//     `svs_submissions` holds one doc per (round, player ID) pair (the SvS
//     prep survey, replacing the old Google Form); `svs_assignments` holds
//     one doc per round with the live computed appointment schedule.
//   • A separate "saves" app — public 4-char codes, immutable docs. Its
//     security must NOT be relaxed; only specific creates are allowed.
//
// OWNERSHIP: this repo (plannet-wos, the hub) is the ONLY place this file is
// allowed to live and be deployed from. Firestore rules are project-wide,
// not per-app — every app repo used to carry its own full copy, and any
// plain `firebase deploy` (not scoped with --only hosting) from ANY of
// those repos would silently redeploy whatever rules happened to be sitting
// there, clobbering collections it didn't know about. (This actually
// happened: battle-calculator's copy went stale and would have default-
// denied foundry-planner + alliance-wiki entirely if anyone had ever run an
// unscoped deploy from it.) Other app repos do NOT have firestore.rules,
// firestore.indexes.json, or a "firestore" key in firebase.json anymore —
// on purpose, so they physically can't redeploy rules by accident.
//
// To add or change a collection: edit this file, then from THIS repo run
//   firebase deploy --only firestore:rules --project tal-coordinator
//
// Anything not listed is default-denied so a future app can't accidentally
// inherit access.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- role hierarchy helpers (used by accounts/alliances/states below) ---
    // Mirrors core/constants/roles.ts's rank table — must stay in sync with it by hand, same
    // duplication discipline as password.util.ts before it (rules can't import app code).
    function myAccount() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
    }
    function myRank() {
      return myAccount().rank;
    }
    function isActiveAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && myAccount().status == 'active';
    }
    // superadmin (rank 0): any scope. state_admin (1) acting on an r5 (target.rank==2): same
    // stateId, state-wide — approving/revoking alliance leaders anywhere in the state is a
    // core state_admin duty, unrelated to which alliance (if any) they personally lead.
    // state_admin acting on an r4 (target.rank==3): only same allianceId, NOT just same
    // state — this is the "most state admins are also their alliance's R5" case (see
    // account.model.ts's allianceId comment); it grants R4 administration for that one
    // alliance only, same as a real R5 would have, never for any other alliance in the
    // state even though state_admin could otherwise reach it via the R5-target case above.
    // r5 (2): same allianceId. r4 (3) can never satisfy this — nothing has rank > 3 for it
    // to act on.
    function sameScope(target) {
      return myRank() == 0
        || (myRank() == 1 && target.rank == 2 && myAccount().stateId == target.stateId)
        || (myRank() == 1 && target.rank == 3 && myAccount().allianceId == target.allianceId)
        || (myRank() == 2 && myAccount().allianceId == target.allianceId);
    }

    // --- states (registry of game servers — see the multi-state rollout plan) --
    // Read is open so the state picker can list them; creating a new state (onboarding a
    // game server) and any other write is superadmin-only.
    match /states/{stateId} {
      allow read: if true;
      allow write: if isActiveAccount() && myRank() == 0;
    }

    // --- alliances (now state-scoped — see the multi-state rollout plan) ------
    // Doc ID is composite, "{stateId}-{slug}", so alliance tags can repeat across states
    // without colliding (see plan notes on why the URL keeps the bare slug instead).
    // Reads stay open — alliance names/config are public, same as before. Structural writes
    // (create, delete, rename, re-scoping — including minting a state-event shell, whose
    // `type` field is set only at creation, see foundry-planner's superadmin.ts) require an
    // active state admin (or superadmin) whose own stateId matches the alliance — this is
    // what actually replaces foundry-planner's old superadmin.ts alliance CRUD, which had no
    // enforcement of its own beyond a client-side guard. A narrower carve-out lets that
    // alliance's own R4/R5 update just the day-to-day operational fields (battle times) from
    // foundry-planner's admin-dashboard — that was never a state_admin-level action, and
    // foundry-planner's AllianceService.updateAlliance() only ever touches those fields.
    match /alliances/{id} {
      allow read: if true;
      allow create, delete: if isActiveAccount() && myRank() <= 1
        && (myRank() == 0 || myAccount().stateId == request.resource.data.stateId);
      allow update: if
        (isActiveAccount() && myRank() <= 1
          && (myRank() == 0 || myAccount().stateId == request.resource.data.stateId))
        || (isActiveAccount() && myAccount().allianceId == id
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['finalTime', 'finalTimeL1', 'finalTimeL2']));
    }

    match /players/{id}          { allow read, write: if true; }
    match /tasks/{id}            { allow read, write: if true; }
    match /assignments/{id}      { allow read, write: if true; }
    match /autoPlanConfigs/{id}  { allow read, write: if true; }
    match /feedback/{id}         { allow read, write: if true; }

    // --- accounts (real Firebase Auth identities now — see the multi-state rollout plan) --
    // Doc ID is the Firebase Auth uid, not a username: this is what lets rules trust
    // `request.auth.uid` as an actual identity across requests, which the old password-hash
    // write-diff trick (see git history) never could — that's what made a real hierarchy and
    // real TOTP possible at all. Four ranks, strictly hierarchical: superadmin(0) >
    // state_admin(1) > r5(2) > r4(3). A rank may only ever act on a STRICTLY lower rank,
    // within its own scope (global for superadmin, stateId for state_admin, allianceId for
    // r5) — see sameScope() below. mfaEnrolled is NOT required before a manager approves a
    // candidate — TOTP enrollment is strongly encouraged (see totp-enroll.ts) but the
    // approving manager can knowingly approve without it; they own that risk for their own
    // state/alliance, not something rules force. The UI surfaces mfaEnrolled status so that's
    // an informed choice.
    match /accounts/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || (isActiveAccount() && myRank() < resource.data.rank && sameScope(resource.data)));

      // Candidate creates their own pending request. Never rank 0 — that account is
      // hand-provisioned (no one above it to approve a self-request), and mfaEnrolled must
      // start false — enrollment is a separate step, never claimed at signup time.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rank in [1, 2, 3]
        && request.resource.data.mfaEnrolled == false;

      allow update: if request.auth != null && (
        // the candidate flipping their own mfaEnrolled flag once TOTP enrollment succeeds —
        // the only field they may ever touch on their own still-pending doc
        (request.auth.uid == uid && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mfaEnrolled'])
          && request.resource.data.mfaEnrolled == true)
        ||
        // an eligible manager acting on a strictly-lower-rank target in their scope — covers
        // approve/revoke (status flip) AND editing rank/stateId/allianceId on an already-
        // active subordinate (e.g. a state_admin reassigning one of their R5s to a different
        // alliance, or demoting one to R4 of an alliance the state_admin themselves leads —
        // same "state_admin edits R5, R5 edits R4" hierarchy as approval, just not limited to
        // the status field). Checked on BOTH old (resource.data) and new (request.resource.
        // data) rank/scope, not just old — a manager can't use this to move someone TO a
        // rank/scope outside their own authority, only within it on both ends.
        //
        // Deliberately NOT requiring resource.data.mfaEnrolled == true here — a manager may
        // approve a candidate who hasn't enrolled TOTP yet; the manager who does that is the
        // one accepting the risk of an unprotected account in their state/alliance, not
        // something rules should force. UI still surfaces TOTP status so that's an informed
        // choice, not a silent one — see superadmin.html/state-admin.html's mfa column.
        (isActiveAccount()
          && myRank() < resource.data.rank
          && myRank() < request.resource.data.rank
          && request.resource.data.rank in [1, 2, 3]
          && sameScope(resource.data)
          && sameScope(request.resource.data))
        ||
        // the account owner syncing their own `email` field with Firebase Auth's real email,
        // after confirming a change via verifyBeforeUpdateEmail() — see AuthService.
        // syncEmailAfterVerification(). Only `email`, and only to the value Firebase Auth's
        // own ID token already claims for this uid (request.auth.token.email) — a fresh
        // token only carries the new address once the confirmation link has actually been
        // clicked, so this can't be used to claim an email that isn't really theirs.
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
          && request.resource.data.email == request.auth.token.email)
      );

      allow delete: if isActiveAccount() && myRank() == 0;
    }

    // --- Alliance Wiki ------------------------------------------------
    // Who can publish/edit/delete an article can't be enforced here without
    // real Auth: the wiki must stay publicly readable, and any "proof of
    // adminship" a write could carry would become part of that same public
    // document — copyable by anyone who ever sees one legitimate edit, not
    // just leaked once. That's a deliberate, accepted trade-off (see the
    // security-hardening plan this was designed against), not an oversight.
    // What IS worth enforcing: basic shape, so a stray or malicious script
    // can't corrupt content with garbage/oversized payloads.
    match /wiki_articles/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['allianceId', 'title', 'content', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status in ['published', 'draft']
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.content is string && request.resource.data.content.size() <= 300000
        && request.resource.data.allianceId is string;
      allow delete: if true;
    }
    match /article_feedback/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['articleId', 'allianceId', 'content', 'createdAt'])
        && request.resource.data.content is string && request.resource.data.content.size() <= 5000;
      allow delete: if true;
    }
    // admin_feedback left open (allow read, write: if true) — reads can't
    // be gated on a password proof at all (a read carries no payload for a
    // rule to check), so this was always going to be either fully open or
    // fully closed with the in-app viewer removed. Kept open by explicit
    // choice: the submit form's "only the superadmin sees this" promise
    // isn't literally true, but the alternative (dropping the feature)
    // wasn't worth it for a low-stakes feedback inbox.
    match /admin_feedback/{id}    { allow read, write: if true; }

    // --- SvS Preparation (open, alliance-trust — same model as above) --
    // One doc per (form, player ID) pair — doc ID == `${formId}_${playerId}`,
    // scoped per SvS prep round (see svs_forms below) so the same player can
    // submit once per round instead of one submission ever colliding across
    // rounds. A resubmission for the same round overwrites the existing doc
    // for that player — see svs-submission.service.ts. Reads are open so the
    // app can look up an existing submission before showing the "you already
    // submitted" diff prompt. Basic shape check only (no real auth possible
    // without a backend, same trade-off as wiki_articles above).
    match /svs_submissions/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.formId is string
        && request.resource.data.formId.size() > 0
        && request.resource.data.formId + '_' + request.resource.data.playerId == docId
        && request.resource.data.allianceAndName is string
        && request.resource.data.allianceAndName.size() > 0
        && request.resource.data.allianceAndName.size() <= 200;
      allow delete: if true;
    }

    // One doc per SvS prep round, created/edited from svs-prep's admin pages — state_admin or
    // above now (originally superadmin-only; widened per the state-event/SvS follow-up so a
    // state's own admin doesn't have to go through superadmin for every round), scoped to
    // their own state same as everywhere else in the hierarchy. Now backed by real auth (see
    // the multi-state rollout plan) — no longer just a shape check, since a real
    // backend-enforceable identity exists to gate on. Reads stay open so the public survey can
    // find "the currently open round" for its state.
    match /svs_forms/{formId} {
      allow read: if true;
      allow create, update: if isActiveAccount() && myRank() <= 1
        && (myRank() == 0 || myAccount().stateId == request.resource.data.stateId)
        && request.resource.data.stateId is string
        && request.resource.data.highestFcLevel in [3, 5, 8, 10]
        && request.resource.data.battleDate is string
        && request.resource.data.submissionsOpenAt is number
        && request.resource.data.submissionsCloseAt is number
        && request.resource.data.submissionsCloseAt > request.resource.data.submissionsOpenAt;
      allow delete: if isActiveAccount() && myRank() <= 1
        && (myRank() == 0 || myAccount().stateId == resource.data.stateId);
    }

    // One doc per SvS prep round holding the live computed appointment schedule — see svs-prep's
    // core/algorithms/assignment.ts and svs-assignment.service.ts. Entirely derived/computed
    // client-side from svs_submissions above (never user-authored free text) and fully
    // recomputed (not merged) on every write, so only a shape check is needed — same
    // alliance-trust model as the rest of this app. Reads are open so the public
    // /assignments/:id page can show the live schedule to any player, without auth.
    match /svs_assignments/{formId} {
      allow read: if true;
      allow create, update: if request.resource.data.formId == formId
        && request.resource.data.construction is map
        && request.resource.data.research is map
        && request.resource.data.training is map
        && request.resource.data.unassignedConstruction is list
        && request.resource.data.unassignedResearch is list
        && request.resource.data.unassignedTraining is list
        && request.resource.data.computedAt is number;
      allow delete: if true;
    }

    // --- Saves app (unchanged from previously-deployed ruleset) ------
    match /saves/{code} {
      // Reads are open — anyone with the 4-char code can load that save.
      allow read: if true;

      // Creates require:
      //   • code-shaped document ID (4 chars, alphabet matches client)
      //   • payload has the schema we expect (recommendations is OPTIONAL — old
      //     saves without it still load, just with no cached cards)
      //   • required fields are the right shape
      //   • createdAt is the server timestamp (no client-set times)
      allow create: if isValidCode(code)
        && request.resource.data.keys().hasOnly(['v', 'heroes', 'gear', 'stats', 'recommendations', 'createdAt'])
        && request.resource.data.keys().hasAll(['v', 'heroes', 'gear', 'stats', 'createdAt'])
        && request.resource.data.v == 1
        && request.resource.data.heroes is list
        && request.resource.data.heroes.size() <= 32
        && request.resource.data.gear is map
        && request.resource.data.stats is map
        && request.resource.data.createdAt == request.time;

      // Saves are immutable — never let a client overwrite or delete a code
      // that's already in use.
      allow update, delete: if false;
    }

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// 4-char codes from the alphabet 23456789ABCDEFGHJKMNPQRSTUVWXYZ.
function isValidCode(code) {
  return code.matches('^[2-9A-HJ-NP-Z]{4}$');
}
